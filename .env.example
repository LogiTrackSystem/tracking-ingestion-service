DATABASE_URL=postgresql://usuario:password@localhost:5432/tracking_db
RABBITMQ_URL=amqp://usuario:password@localhost:5672/
ROUTING_SERVICE_URL=http://localhost:8003
FLEET_SERVICE_URL=http://localhost:8000
SHIPMENT_SERVICE_URL=http://localhost:8001
SIM_TICK_SEGUNDOS=5
SIM_FACTOR_TIEMPO=120
SIM_COMBUSTIBLE_INICIAL_PCT=80
# Clave compartida con el gateway y los demás servicios (producción). Vacía = sin restricción (local).
INTERNAL_API_KEY=

# Por debajo de esta distancia en línea recta el vehículo "ya está en el origen" y no se simula tramo en vacío
UMBRAL_MISMO_LUGAR_KM=2

# Espera máxima (ms) por un candado de fila antes de fallar; 0 = sin límite
DB_LOCK_TIMEOUT_MS=15000

# Espera máxima (s) por Routing /trayecto (debe superar los reintentos de OSRM de Routing)
TIMEOUT_TRAYECTO_S=30

# Reintentos (sin bloquear) cuando un evento llega mientras el ciclo de simulación tiene tomada la simulación del envío
ESPERA_SIMULACION_S=0.5
INTENTOS_SIMULACION=120
